# Скопируйте в /opt/model/api/.env на сервере (не в Git).
PORT=3847
HOST=127.0.0.1

# Google Cloud Console → OAuth client (Web). Origins: https://live-model.ru, http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Случайная длинная строка (openssl rand -hex 32)
SESSION_SECRET=

# Ваша почта Google — единственный владелец и разработчик (можно несколько через запятую)
OWNER_EMAILS=you@gmail.com

# Каталог users.json на сервере
MODEL_DATA_DIR=/opt/model/api/data

# Локальная разработка без Google (только localhost)
# DEV_AUTH_BYPASS=1
